; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt < %s -passes=sroa -S | FileCheck %s

target datalayout = "e-p:64:64:64-p1:64:64:64-ni:1-i8:8:8-i16:16:16-i32:32:32-i64:64:64-n8:16:32:64"

; Bytes can be converted to integral pointers, but not to non-integral ones.
define ptr addrspace(1) @byte_to_nonintegral_ptr(b64 %x) {
; CHECK-LABEL: define ptr addrspace(1) @byte_to_nonintegral_ptr(
; CHECK-SAME: b64 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = alloca b64, align 8
; CHECK-NEXT:    store b64 [[X]], ptr [[A]], align 8
; CHECK-NEXT:    [[A_0_V:%.*]] = load ptr addrspace(1), ptr [[A]], align 8
; CHECK-NEXT:    ret ptr addrspace(1) [[A_0_V]]
;
  %a = alloca b64, align 8
  store b64 %x, ptr %a, align 8
  %v = load ptr addrspace(1), ptr %a, align 8
  ret ptr addrspace(1) %v
}

define ptr @byte_to_integral_ptr(b64 %x) {
; CHECK-LABEL: define ptr @byte_to_integral_ptr(
; CHECK-SAME: b64 [[X:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = alloca b64, align 8
; CHECK-NEXT:    store b64 [[X]], ptr [[A]], align 8
; CHECK-NEXT:    [[A_0_V:%.*]] = load ptr, ptr [[A]], align 8
; CHECK-NEXT:    ret ptr [[A_0_V]]
;
  %a = alloca b64, align 8
  store b64 %x, ptr %a, align 8
  %v = load ptr, ptr %a, align 8
  ret ptr %v
}
